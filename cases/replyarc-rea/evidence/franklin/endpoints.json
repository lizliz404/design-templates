{"m":"POST","p":"/api/widget/flow-submit","use":"in-chat form (formId, values[{id,label,type,value}])"},
{"m":"POST","p":"/api/widget/hub-contact","use":"help hub email contact {kind,email,name,message}"},
{"m":"POST","p":"/api/widget/upload","use":"multipart attachment (max 3 MB for this bot)"},
