  "capture": {
    "after_each_step": ["url", "dom", "accessibility", "screenshot"],
    "at_end": ["url", "history"],
    "events": ["console", "page-errors", "network"],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}
