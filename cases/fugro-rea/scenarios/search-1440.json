{
  "browser": {
    "mode": "launch",
    "executable_path": "/home/liz/.cache/ms-playwright/chromium-1248/chrome-linux64/chrome",
    "headless": true
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "no-preference",
    "service_workers": "block"
  },
  "start_url": {
    "url": "https://www.fugro.com/"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 5000
    },
    {
      "step_id": "decline-cookies",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Decline all"
      },
      "timeout_ms": 8000
    },
    {
      "step_id": "cookies-gone",
      "action": "wait_for_timeout",
      "duration_ms": 1200
    },
    {
      "step_id": "open-search",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "button[title='Search']"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "search-open",
      "action": "wait_for_timeout",
      "duration_ms": 1500
    },
    {
      "step_id": "type-query",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "input[type='search'], input[placeholder*='earch'], input[name*='earch'], [role='searchbox']"
      },
      "value": {
        "source": "literal",
        "value": "offshore wind"
      },
      "timeout_ms": 8000
    },
    {
      "step_id": "results-settle",
      "action": "wait_for_timeout",
      "duration_ms": 2500
    }
  ],
  "capture": {
    "after_each_step": [
      "url",
      "dom",
      "accessibility",
      "screenshot"
    ],
    "at_end": [
      "url"
    ],
    "events": [
      "page-errors",
      "network"
    ],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}