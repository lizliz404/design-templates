{
  "browser": {
    "mode": "launch",
    "executable_path": "/home/liz/.cache/ms-playwright/chromium-1248/chrome-linux64/chrome",
    "headless": true
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "no-preference",
    "service_workers": "block"
  },
  "start_url": {
    "url": "https://www.saronic.com/"
  },
  "actions": [
    {
      "step_id": "goto-portalpha",
      "action": "goto",
      "destination": {
        "url": "https://www.saronic.com/portalpha"
      },
      "wait_until": "domcontentloaded",
      "timeout_ms": 30000
    },
    {
      "step_id": "settle-portalpha",
      "action": "wait_for_timeout",
      "duration_ms": 3500
    },
    {
      "step_id": "goto-mission",
      "action": "goto",
      "destination": {
        "url": "https://www.saronic.com/mission"
      },
      "wait_until": "domcontentloaded",
      "timeout_ms": 30000
    },
    {
      "step_id": "settle-mission",
      "action": "wait_for_timeout",
      "duration_ms": 3500
    },
    {
      "step_id": "goto-team",
      "action": "goto",
      "destination": {
        "url": "https://www.saronic.com/team"
      },
      "wait_until": "domcontentloaded",
      "timeout_ms": 30000
    },
    {
      "step_id": "settle-team",
      "action": "wait_for_timeout",
      "duration_ms": 3500
    }
  ],
  "capture": {
    "after_each_step": [
      "url",
      "dom",
      "accessibility",
      "screenshot"
    ],
    "at_end": [
      "url",
      "history"
    ],
    "events": [
      "console",
      "page-errors",
      "network"
    ],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}