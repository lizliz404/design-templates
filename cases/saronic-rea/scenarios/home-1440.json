{
  "browser": {
    "mode": "launch",
    "executable_path": "/home/liz/.cache/ms-playwright/chromium-1248/chrome-linux64/chrome",
    "headless": true
  },
  "environment": {
    "viewport": { "width": 1440, "height": 900, "device_scale_factor": 1 },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "no-preference",
    "service_workers": "block"
  },
  "start_url": { "url": "https://www.saronic.com/" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 8000 }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "screenshot", "url", "history"],
    "events": ["console", "page-errors", "network"],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}
